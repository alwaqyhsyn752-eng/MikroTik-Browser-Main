<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="البادئة (Prefix)" android:textColor="#FFFFFF" android:textSize="11sp"/>
        <EditText android:id="@+id/etPrefix" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="42091"
            android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:textSize="12sp" android:background="#333333"
            android:padding="6dp" android:layout_marginBottom="4dp"
            android:inputType="text"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اللاحقة (Suffix)" android:textColor="#FFFFFF" android:textSize="11sp"/>
        <EditText android:id="@+id/etSuffix" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="3"
            android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:textSize="12sp" android:background="#333333"
            android:padding="6dp" android:layout_marginBottom="4dp"
            android:inputType="text"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="عدد الأرقام" android:textColor="#FFFFFF" android:textSize="11sp"/>
                <EditText android:id="@+id/etDigits" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="2"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="12sp" android:background="#333333"
                    android:padding="6dp" android:inputType="text"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="المحاولات" android:textColor="#FFFFFF" android:textSize="11sp"/>
                <EditText android:id="@+id/etAttempts" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="100"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="12sp" android:background="#333333"
                    android:padding="6dp" android:inputType="text"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⏱ الإعدادات الزمنية (ms)"
            android:textColor="#FFEB3B" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginTop="6dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pause" android:textColor="#CCCCCC" android:textSize="10sp"/>
                <EditText android:id="@+id/etPause" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="30"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="11sp" android:background="#222222"
                    android:padding="4dp" android:inputType="text"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Retry" android:textColor="#CCCCCC" android:textSize="10sp"/>
                <EditText android:id="@+id/etRetry" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="1500"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="11sp" android:background="#222222"
                    android:padding="4dp" android:inputType="text"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="StatusEvery" android:textColor="#CCCCCC" android:textSize="10sp"/>
                <EditText android:id="@+id/etStatusEvery" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="30"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="11sp" android:background="#222222"
                    android:padding="4dp" android:inputType="text"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RTT" android:textColor="#CCCCCC" android:textSize="10sp"/>
                <EditText android:id="@+id/etRttEvery" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="8"
                    android:textColor="#FFFFFF" android:textColorHint="#666666"
                    android:textSize="11sp" android:background="#222222"
                    android:padding="4dp" android:inputType="text"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="السجل:" android:textColor="#FFEB3B" android:textSize="11sp"
            android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/logText" android:layout_width="match_parent"
            android:layout_height="180dp" android:textColor="#00FF00"
            android:background="#000000" android:padding="6dp"
            android:textSize="10sp" android:fontFamily="monospace"
            android:scrollbars="vertical"/>
    </LinearLayout>
</ScrollView>
