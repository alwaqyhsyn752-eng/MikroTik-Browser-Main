<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp" android:background="#222222">
        <EditText android:id="@+id/urlBar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="https://..." android:inputType="textUri"
            android:textColor="#FFFFFF" android:textColorHint="#999999" android:textSize="13sp"
            android:background="#333333" android:padding="8dp" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="اذهب" android:textSize="12sp" android:minWidth="60dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#333333">
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="◀" android:textSize="16sp"/>
        <Button android:id="@+id/btnForward" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶" android:textSize="16sp"/>
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⟳" android:textSize="16sp"/>
        <Button android:id="@+id/btnFinder" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="2" android:text="🔍 التخمين" android:textSize="12sp"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100"/>

    <WebView android:id="@+id/webView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#000000"/>

    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="#0D0D0D" android:visibility="gone" android:padding="6dp">

        <TextView android:id="@+id/voucherResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone"
            android:textColor="#000000" android:background="#00FF00"
            android:padding="10dp" android:textSize="16sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFEB3B"
            android:textSize="11sp" android:text="متوقف" android:layout_marginBottom="4dp"/>

        <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="300dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="البادئة (Prefix)" android:textColor="#CCCCCC" android:textSize="10sp"/>
                        <EditText android:id="@+id/etPrefix" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="42091"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="12sp" android:background="#333333"
                            android:padding="4dp" android:inputType="text"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="اللاحقة (Suffix)" android:textColor="#CCCCCC" android:textSize="10sp"/>
                        <EditText android:id="@+id/etSuffix" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="3"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="12sp" android:background="#333333"
                            android:padding="4dp" android:inputType="text"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="عدد الأرقام" android:textColor="#CCCCCC" android:textSize="10sp"/>
                        <EditText android:id="@+id/etDigits" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="2"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="12sp" android:background="#333333"
                            android:padding="4dp" android:inputType="text"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="المحاولات" android:textColor="#CCCCCC" android:textSize="10sp"/>
                        <EditText android:id="@+id/etAttempts" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="100"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="12sp" android:background="#333333"
                            android:padding="4dp" android:inputType="text"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⏱ الإعدادات الزمنية (ms)" android:textColor="#FFEB3B"
                    android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="التأخير" android:textColor="#CCCCCC" android:textSize="9sp"/>
                        <EditText android:id="@+id/etPause" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="300"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="11sp" android:background="#222222"
                            android:padding="3dp" android:inputType="text"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="الانتظار" android:textColor="#CCCCCC" android:textSize="9sp"/>
                        <EditText android:id="@+id/etRetry" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="1000"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="11sp" android:background="#222222"
                            android:padding="3dp" android:inputType="text"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="حجم الدفعة" android:textColor="#CCCCCC" android:textSize="9sp"/>
                        <EditText android:id="@+id/etStatusEvery" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="300"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="11sp" android:background="#222222"
                            android:padding="3dp" android:inputType="text"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="التوازي" android:textColor="#CCCCCC" android:textSize="9sp"/>
                        <EditText android:id="@+id/etRttEvery" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="5"
                            android:textColor="#FFFFFF" android:textColorHint="#666666"
                            android:textSize="11sp" android:background="#222222"
                            android:padding="3dp" android:inputType="text"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="▶ ابدأ"/>
            <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="⏹ إيقاف" android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📋 السجل:" android:textColor="#FFEB3B" android:textSize="10sp"/>
        <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent"
            android:layout_height="200dp" android:background="#000000">
            <TextView android:id="@+id/logText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#00FF00"
                android:padding="6dp" android:textSize="10sp"
                android:fontFamily="monospace"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
