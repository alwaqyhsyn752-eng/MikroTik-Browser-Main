<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp" android:background="#222">
        <EditText android:id="@+id/urlBar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="http://..." android:textColor="#FFF" android:textColorHint="#888"
            android:textSize="12sp" android:background="#333" android:padding="6dp" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اذهب" android:textSize="12sp" android:minWidth="50dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#333">
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="◀" android:textSize="14sp"/>
        <Button android:id="@+id/btnForward" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶" android:textSize="14sp"/>
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⟳" android:textSize="14sp"/>
        <Button android:id="@+id/btnFinder" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="2" android:text="🔍 الإعدادات" android:textSize="12sp"/>
    </LinearLayout>

    <ScrollView android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxHeight="220dp" android:visibility="gone" android:background="#1A1A1A">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/etPrefix" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Prefix" android:textColor="#FFF" android:background="#333" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etSuffix" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Suffix" android:textColor="#FFF" android:background="#333" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etDigits" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Digits" android:inputType="number" android:textColor="#FFF" android:background="#333" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etAttempts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Attempts" android:inputType="number" android:textColor="#FFF" android:background="#333" android:padding="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                <EditText android:id="@+id/etPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Pause" android:textColor="#FFF" android:background="#222" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etRetry" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Retry" android:textColor="#FFF" android:background="#222" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etStatusEvery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Status" android:textColor="#FFF" android:background="#222" android:padding="4dp" android:layout_marginEnd="2dp"/>
                <EditText android:id="@+id/etRttEvery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Threads" android:textColor="#FFF" android:background="#222" android:padding="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="▶ ابدأ"/>
                <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏹ إيقاف" android:layout_marginStart="4dp"/>
                <Button android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗑️" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/voucherResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#000" android:background="#0F0" android:padding="8dp" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </ScrollView>

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFEB3B" android:background="#000" android:textSize="10sp" android:padding="2dp" android:text="متوقف"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <WebView android:id="@+id/web0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
            <WebView android:id="@+id/web1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <WebView android:id="@+id/web2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
            <WebView android:id="@+id/web3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="110dp" android:background="#000">
        <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F0" android:padding="4dp" android:textSize="9sp" android:fontFamily="monospace"/>
    </ScrollView>

</LinearLayout>
