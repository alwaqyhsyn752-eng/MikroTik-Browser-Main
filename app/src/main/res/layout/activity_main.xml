<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- شريط التحكم العلوي -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#222222" android:padding="4dp">
        <EditText android:id="@+id/urlBar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFF" android:background="#333" android:textSize="11sp"
            android:text="http://7.7.7.7/index.html" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اذهب" android:textSize="10sp" android:minWidth="40dp"/>
    </LinearLayout>

    <!-- لوحة الإعدادات -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp" android:background="#111">
        <EditText android:id="@+id/etPrefix" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Prefix" android:textColor="#FFF" android:background="#333" android:textSize="10sp" android:layout_marginEnd="2dp"/>
        <EditText android:id="@+id/etSuffix" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Suffix" android:textColor="#FFF" android:background="#333" android:textSize="10sp" android:layout_marginEnd="2dp"/>
        <EditText android:id="@+id/etDigits" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Digits" android:textColor="#FFF" android:background="#333" android:textSize="10sp" android:layout_marginEnd="2dp"/>
        <EditText android:id="@+id/etAttempts" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Try" android:textColor="#FFF" android:background="#333" android:textSize="10sp"/>
    </LinearLayout>

    <!-- أزرار التشغيل -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp" android:background="#1A1A1A">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶ ابدأ (4 شاشات)" android:textSize="11sp"/>
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⏹ إيقاف" android:textSize="11sp" android:layout_marginStart="4dp"/>
        <Button android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🗑️" android:textSize="11sp" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- شريط السجل المصغر -->
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#00FF00" android:background="#000" android:textSize="10sp" android:padding="2dp" android:text="جاهز..."/>

    <!-- الشاشات الأربع (تقسيم 2x2) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <WebView android:id="@+id/web0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
            <WebView android:id="@+id/web1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <WebView android:id="@+id/web2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
            <WebView android:id="@+id/web3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
