<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 باحث الكروت"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="املأ الحقول حسب بيانات شبكتك"
        android:textColor="#FFFF00"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رابط صفحة الدخول:"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"/>
    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثال: http://192.168.88.1/login"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="12sp"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="البادئة (Prefix) — بداية كل كرت:"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"/>
    <EditText
        android:id="@+id/etPrefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثال: 42091"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="12sp"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اللاحقة (Suffix) — نهاية كل كرت:"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"/>
    <EditText
        android:id="@+id/etSuffix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثال: 3 أو اتركه فارغاً"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="12sp"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عدد الأرقام المتغيرة (Digits):"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"/>
    <EditText
        android:id="@+id/etDigits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثال: 2"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="12sp"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عدد المحاولات (Attempts):"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"/>
    <EditText
        android:id="@+id/etAttempts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثال: 100"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="12sp"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ ابدأ"/>
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹ إيقاف"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textColor="#00FF00"
        android:background="#000000"
        android:padding="6dp"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical"/>

    <WebView
        android:id="@+id/hiddenWeb"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"/>
</LinearLayout>
