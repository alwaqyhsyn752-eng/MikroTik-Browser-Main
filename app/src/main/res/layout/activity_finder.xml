<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#111" android:padding="8dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔍 باحث الكروت" android:textColor="#0F0" android:textSize="18sp"
        android:textStyle="bold" android:layout_marginBottom="6dp"/>

    <EditText android:id="@+id/etUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="URL" android:textColor="#FFF" android:textColorHint="#888" android:textSize="12sp"
        android:background="#333" android:padding="6dp" android:layout_marginBottom="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/etPrefix" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Prefix" android:textColor="#FFF" android:textColorHint="#888"
            android:textSize="12sp" android:background="#333" android:padding="6dp" android:layout_marginEnd="4dp"/>
        <EditText android:id="@+id/etSuffix" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Suffix" android:textColor="#FFF" android:textColorHint="#888"
            android:textSize="12sp" android:background="#333" android:padding="6dp" android:layout_marginEnd="4dp"/>
        <EditText android:id="@+id/etDigits" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Digits" android:inputType="number" android:textColor="#FFF"
            android:textColorHint="#888" android:textSize="12sp" android:background="#333" android:padding="6dp" android:layout_marginEnd="4dp"/>
        <EditText android:id="@+id/etAttempts" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Try" android:inputType="number" android:textColor="#FFF"
            android:textColorHint="#888" android:textSize="12sp" android:background="#333" android:padding="6dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶ ابدأ"/>
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⏹ إيقاف" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvLog" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:textColor="#0F0"
        android:background="#000" android:padding="6dp" android:textSize="10sp"
        android:fontFamily="monospace" android:scrollbars="vertical"/>

    <!-- WebView مخفي ينفذ التخمين بنفس جلسة المتصفح -->
    <WebView android:id="@+id/hiddenWeb" android:layout_width="1dp" android:layout_height="1dp"
        android:visibility="invisible"/>
</LinearLayout>
